[Unit]
Description=Alexa-Hermes Flask Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/alexa-hermes
EnvironmentFile=/root/alexa-hermes/.env
ExecStart=/usr/local/lib/hermes-agent/venv/bin/gunicorn -w 2 -b 127.0.0.1:8443 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
